# Copy to .env and fill in locally. NEVER commit the real .env file.
# .env is already in .gitignore.
#
# Everything here is optional unless you use the matching feature.

# --- Hugging Face (model downloads; required for gated repos like the
#     OrcaSAQ-2 community GGUF, which requires accepting its license) ---
HF_TOKEN=

# --- Google Colab (colab-mcp / notebook execution driver) ---
COLAB_API_TOKEN=
COLAB_NOTEBOOK_TOKEN=

# --- Kaggle (kaggle-mcp / kernels API) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- llama-server bearer token (keeps even loopback/tunneled access authenticated) ---
LLAMA_SERVER_TOKEN=

# --- Agent-Reach research channels (only needed for login-gated platforms;
#     store your OWN account's exported cookies, never anyone else's) ---
AGENT_REACH_GITHUB_TOKEN=
AGENT_REACH_YOUTUBE_API_KEY=

# --- Pinned external skill repos (set once you vendor/update them) ---
AGENT_SKILLS_ADDYOSMANI_REF=
AGENT_SKILLS_VERCEL_REF=
AGENT_REACH_REF=
